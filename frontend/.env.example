# Base URL of the AGNI API (docs/API_CONTRACT.md), without a trailing slash.
#   local backend:  http://localhost:8000
#   production:     the public HTTPS URL (GitHub Pages is HTTPS, so http:// will be blocked)
# Leave empty to run the app on built-in mock data.
VITE_API_BASE=

# Never put the FIRMS MAP key here: anything prefixed VITE_ ships to the browser.
# The key lives only on the backend.
