# Fire forecast model, v5 (v5_unified_ffdi_cv). Paths here are relative to this folder.
# Allow-list: everything is ignored, then only what is needed to RUN v5 forecasts is re-included.
# Training / evaluation scripts (train_forecast.py, evaluate.py, build_dataset.py, attributes.py,
# run_pipeline.py, run_v5_v6.sh) and the design PDF are kept locally only.
#
# fcst_config.py also expects ../ml_pipeline/, ../backend/data/parquet/ and ../data/weather/
# next to this folder. Those are outside this folder, so this file cannot include them.

/*
!/.gitignore
!/README.md

# ---- forecast code (load the model and run forecast.py)
!/fcst_config.py
!/fmodels.py
!/history.py
!/forecast.py
!/forecast_weather.py
!/fire_danger.py
!/weather_forecast_template.csv

# ---- v5 weights (lead_1/3/7.joblib, ~8 MB each) + training report json
!/models/
/models/*
!/models/*.joblib
!/models/*.json

# ---- v5 evaluation report json (output/ itself is 3.7 GB and stays out)
!/output/
/output/*
!/output/evaluation_v5/
/output/evaluation_v5/*
!/output/evaluation_v5/evaluation_report.json

# ---- never commit
__pycache__/
*.py[cod]
*.log
*.out
